								]
							}
						}
					]
				},
				{
					"name": "List labels shows usage count 1",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "OCS-APIRequest",
								"value": "true",
								"type": "text"

		{
			"name": "Label Management",
			"description": "Admin label management: create via OR, usage count 0→1, invalid colour 4xx, admin-only listing/cascade endpoints, cascade delete sweeps task.labels. Requires the planninq app + register installed; admin auth. spec: openspec/changes/label-management-admin/specs/admin-user-settings/spec.md",
			"item": [
				{
					"name": "Create label via OR API",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "OCS-APIRequest",
								"value": "true",
								"type": "text"
							}
						],
						"url": "{{base_url}}/index.php/apps/openregister/api/objects/planninq/label",
						"body": {
							"mode": "raw",
							"raw": "{\"title\":\"Newman label\",\"color\":\"#33AA55\",\"description\":\"integration\"}"
						},
						"description": "Create a label directly on the OR label schema (ADR-022 create path)."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('label created', function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
									"    const j = pm.response.json();",
									"    pm.collectionVariables.set('label_id', j.id || (j['@self'] && j['@self'].id));",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "List labels shows usage count 0",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "OCS-APIRequest",
								"value": "true",
								"type": "text"
							}
						],
						"url": "{{base_url}}/index.php/apps/planninq/api/labels",
						"description": "Admin usage listing; the new label appears with usageCount 0."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('label listed with count 0', function () {",
									"    pm.response.to.have.status(200);",
									"    const labels = pm.response.json().labels || [];",
									"    const mine = labels.find(l => l.id === pm.collectionVariables.get('label_id'));",
									"    pm.expect(mine, 'created label present').to.be.an('object');",
									"    pm.expect(mine.usageCount).to.eql(0);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Create task referencing the label",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "OCS-APIRequest",
								"value": "true",
								"type": "text"
							}
						],
						"url": "{{base_url}}/index.php/apps/openregister/api/objects/planninq/task",
						"body": {
							"mode": "raw",
							"raw": "{\"title\":\"Newman label task\",\"status\":\"open\",\"project\":\"{{project_id}}\",\"labels\":[\"{{label_id}}\"]}"

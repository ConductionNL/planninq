				},
				{
					"name": "Cascade delete sweeps the label",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "OCS-APIRequest",
								"value": "true",
								"type": "text"
							}
						],
						"url": "{{base_url}}/index.php/apps/planninq/api/labels/{{label_id}}",
						"description": "Admin cascade delete: removes the UUID from referencing tasks then deletes the label; reports tasksUpdated."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('cascade delete reports tasksUpdated', function () {",
									"    pm.response.to.have.status(200);",
									"    const j = pm.response.json();",
									"    pm.expect(j.success).to.be.true;",
									"    pm.expect(j.tasksUpdated).to.be.at.least(1);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Task labels no longer contain the UUID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "OCS-APIRequest",
								"value": "true",
								"type": "text"
							}
						],
						"url": "{{base_url}}/index.php/apps/openregister/api/objects/planninq/task/{{label_task}}",
						"description": "The swept task must not retain a dangling label reference."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('task label reference removed', function () {",
									"    pm.response.to.have.status(200);",
									"    const j = pm.response.json();",
									"    const labels = j.labels || (j['@self'] && j['@self'].labels) || [];",
									"    pm.expect(labels).to.not.include(pm.collectionVariables.get('label_id'));",
									"});"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "Task Collaboration",
			"description": "Comments (OR notes, ICommentsManager-backed) and audit trail on a task, via OpenRegister per-object APIs (ADR-022; no planninq pass-through). Covers notes CRUD on a seeded task (create -> list shows author+message -> edit own -> delete own), an RBAC-negative read for an inaccessible task, and the audit trail carrying the status-change entry after an update. spec: openspec/specs/task-collaboration.md",
			"item": [
				{
					"name": "Seed task for collaboration",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "OCS-APIRequest",
								"value": "true",
								"type": "text"
							}
						],
						"url": "{{base_url}}/index.php/apps/openregister/api/objects/planninq/task",
						"body": {
							"mode": "raw",
							"raw": "{\"title\":\"Collaboration task\",\"status\":\"open\"}"
						},
						"description": "Create a task to attach comments and audit-trail entries to."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('collab task created', function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
									"    const j = pm.response.json();",
									"    pm.collectionVariables.set('collab_task', j.id || (j['@self'] && j['@self'].id));",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Add a comment to the task",
					"request": {

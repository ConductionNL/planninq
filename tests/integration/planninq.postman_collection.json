{
	"info": {
		"_postman_id": "planninq-collection",
		"name": "Planninq Integration Tests",
		"description": "Integration test collection for the planninq Nextcloud app.\nReplace this with your actual API tests.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "basic",
		"basic": [
			{
				"key": "username",
				"value": "{{admin_user}}",
				"type": "string"
			},
			{
				"key": "password",
				"value": "{{admin_password}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "admin_user",
			"value": "admin",
			"type": "string"
		},
		{
			"key": "admin_password",
			"value": "admin",
			"type": "string"
		},
		{
			"key": "project_id",
			"value": "",
			"type": "string",
			"description": "Set by 'Create the project the later requests use' in Health Check. A fresh install holds no projects since platform-demo-data (only the five default labels), so the collection makes its own instead of relying on a seeded 'Client Portal v2'."
		}
	],
	"item": [
		{
			"name": "Health Check",
			"item": [
				{
					"name": "Nextcloud status",
					"request": {
						"method": "GET",
						"url": "{{base_url}}/status.php",
						"description": "Verify Nextcloud is running.",
						"header": [
							{
								"key": "OCS-APIRequest",
								"value": "true",
								"type": "text"
							}
						]
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Nextcloud is running', function () {",
									"    pm.response.to.have.status(200);",
									"    const json = pm.response.json();",
									"    pm.expect(json.installed).to.be.true;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Create the project the later requests use",
					"request": {
						"method": "POST",
						"url": "{{base_url}}/index.php/apps/openregister/api/objects/planninq/project",
						"header": [
							{
								"key": "OCS-APIRequest",
								"value": "true",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"title\": \"Newman base project\", \"status\": \"active\", \"owner\": \"{{admin_user}}\", \"members\": [\"{{admin_user}}\"]}"
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('project created', function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
									"    const json = pm.response.json();",
									"    pm.collectionVariables.set('project_id', json.id || (json['@self'] || {}).id);",
									"});"
								]
							}
						}
					]
				}
			]
		},

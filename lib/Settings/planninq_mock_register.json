          "metadata": {
            "title": "Metadata",
            "type": "object",
            "description": "Declared catch-all for source-system fields: imported custom fields and provenance keys (e.g. jiraKey, jiraId, migratedAt). Declared explicitly so magic-table storage persists it.",
            "default": {}

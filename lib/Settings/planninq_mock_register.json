            "nullable": true,
            "$ref": "task"
          },
          "calendarEventUid": {
            "title": "Calendar Event UID",
            "type": "string",
            "description": "UID of the linked NC Tasks / CalDAV VTODO event",
            "nullable": true
          },
          "completedAt": {
            "title": "Completed At",
            "type": "string",
            "description": "ISO 8601 datetime when the task was completed",
            "format": "date-time",
            "nullable": true
          },
          "issueType": {
            "title": "Issue Type",

          "delete": [
            {
              "group": "authenticated",
              "match": {
                "project": {
                  "$in": {
                    "$lookup": {
                      "schema": "project",
                      "field": "id",
                      "where": {
                        "members": {
                          "$contains": "$userId"
                        }
                      }
                    }
                  }
                }
              }
            },
            {
              "group": "admin"
            }
          ]
        },
        "properties": {
          "title": {
            "title": "Column Heading",
            "type": "string",
            "description": "Column heading (e.g. 'In Progress')"
          },
          "project": {
            "title": "Project",
            "type": "string",
            "description": "UUID of the parent Project",
            "format": "uuid",
            "$ref": "project"
          },
          "order": {
            "title": "Display Order",
            "type": "integer",
            "description": "Left-to-right display order (0-based)",

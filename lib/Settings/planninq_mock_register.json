            "title": "Start Date",
            "type": "string",
            "description": "Start date in ISO 8601 format",
            "format": "date"
          },
          "estimatedDuration": {
            "title": "Estimated Duration",
            "type": "integer",
            "description": "Estimated effort in minutes"
          },
          "percentComplete": {
            "title": "Percent Complete",

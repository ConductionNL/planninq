          "defaultAssignee": {
            "title": "Default Assignee",
            "type": "string",
            "description": "Nextcloud user UID who receives new tasks by default"
          },
          "caseReference": {
            "title": "Case Reference",
            "type": "string",
            "description": "UUID of a linked Procest case",
            "format": "uuid",
            "nullable": true
          },
          "labels": {
            "title": "Labels",
            "type": "array",
            "description": "UUIDs of Label objects available within this project",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "default": []
          },
          "key": {
            "title": "Key",
            "type": "string",
            "description": "Short unique project key used as the prefix of task keys (e.g. PLX). Preserved from the source system on import.",
            "nullable": true
          },
          "metadata": {
            "title": "Metadata",
            "type": "object",
            "description": "Declared catch-all for source-system fields and provenance keys (e.g. jiraProjectId, migratedAt). Declared explicitly so magic-table storage persists it.",
            "default": {}

            "title": "Header Colour",
            "type": "string",
            "description": "Hex colour code for the column header",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "type": {
            "title": "Column Type",
            "type": "string",
            "description": "Functional type: active columns hold in-flight work; done columns auto-complete tasks",
            "enum": [
              "active",
              "done"
            ],
            "default": "active"
          }
        }
      },
      "dependency": {
        "slug": "dependency",
        "icon": "VectorPolyline",
        "version": "0.2.0",
        "title": "Dependency",
        "description": "A directed dependency edge between two tasks of the same project (blocker → blocked). One row per directed edge. Maps to schema:Action.",
        "x-schema-org": "schema:Action",
        "type": "object",
        "required": [
          "blocker",
          "blocked"
        ],
        "authorization": {
          "read": [
            {
              "group": "authenticated"
            },
            {
              "group": "admin"
            }
          ],
          "create": [
            "admin"
          ],
          "update": [
            "admin"
          ],
          "delete": [
            "admin"
          ]
        },
        "properties": {
          "blocker": {
            "title": "Blocker Task",
            "type": "string",
            "description": "UUID of the task that blocks (must complete before the blocked task can proceed)",
            "format": "uuid",
            "$ref": "task"
          },
          "blocked": {
            "title": "Blocked Task",
            "type": "string",
            "description": "UUID of the task that is blocked (waits on the blocker)",
            "format": "uuid",
            "$ref": "task"
          },
          "type": {
            "title": "Link Type",
            "type": "string",
            "description": "Kind of relation the edge expresses. blocks keeps the original blocker/blocked semantics; other values model non-blocking links between work items.",
            "enum": [
              "blocks",
              "relates",
              "duplicates",
              "clones",
              "splits",
              "causes"
            ],
            "default": "blocks"
          }
        }
      },

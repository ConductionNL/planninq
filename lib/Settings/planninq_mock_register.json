              "nl": "Taak \"{{title}}\" moet binnenkort af"
            }
          }
        },
        "properties": {
          "title": {
            "title": "Task Title",
            "type": "string",
            "description": "Short title of the task"
          },
          "description": {
            "title": "Description",
            "type": "string",
            "description": "Detailed description"
          },
          "status": {
            "title": "Status",
            "type": "string",

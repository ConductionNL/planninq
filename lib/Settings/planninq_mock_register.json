      "project": {
        "slug": "project",
        "icon": "FolderOutline",
        "version": "0.2.0",
        "title": "Project",
        "description": "A container grouping related tasks and kanban columns. Maps to schema:CreativeWork.",
        "x-schema-org": "schema:CreativeWork",
        "type": "object",
        "required": [
          "title",
          "status"

          "contractorRefs": {
            "title": "Contractors",
            "type": "array",
            "description": "UUID references to contractor contact/domain objects with portal visibility of this project — the portal-subject scoping key; distinct from members which are Nextcloud user ids",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "default": []

                "project": {
                  "$in": {
                    "$lookup": {
                      "schema": "project",
                      "field": "id",
                      "where": {
                        "members": {
                          "$contains": "$userId"
                        }
                      }
                    }
                  }
                }
              }
            },
            {
              "group": "admin"
            }
          ],
          "create": [
            {
              "group": "authenticated",
              "match": {
                "project": {
                  "$in": {
                    "$lookup": {
                      "schema": "project",
                      "field": "id",
                      "where": {
                        "members": {
                          "$contains": "$userId"
                        }
                      }
                    }
                  }
                }
              }
            },
            {
              "group": "admin"
            }
          ],
          "update": [
            {
              "group": "authenticated",
              "match": {
                "project": {
                  "$in": {
                    "$lookup": {
                      "schema": "project",
                      "field": "id",
                      "where": {
                        "members": {
                          "$contains": "$userId"
                        }
                      }
                    }
                  }
                }
              }

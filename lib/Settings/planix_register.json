{
  "openapi": "3.0.0",
  "info": {
    "title": "Planix Register",
    "description": "Register containing all schemas for the Planix application.",
    "version": "0.2.5"
  },
  "x-openregister": {
    "type": "application",
    "app": "planix",
    "openregister": "^v0.2.10",
    "description": "Flow-based kanban project and task management for Nextcloud dev and IT teams"
  },
  "paths": {},
  "components": {
    "registers": {
      "planix": {
        "title": "Planix",
        "description": "Planix application data register — tasks, projects, columns, time entries, and labels.",
        "slug": "planix",
        "version": "0.2.5",
        "schemas": ["task", "project", "column", "timeEntry", "label", "dependency"],
        "tablePrefix": "planix",
        "folder": "planix",
        "publicRead": false,
        "publicWrite": false
      }
    },
    "schemas": {
      "task": {
        "slug": "task",
        "icon": "CheckboxMarkedOutline",
        "version": "0.1.3",
        "title": "Task",
        "description": "A discrete unit of work. Maps to iCalendar VTODO (RFC 5545) and schema:PlanAction.",
        "type": "object",
        "required": ["title", "status"],
        "authorization": {
          "read": [
            {
              "group": "authenticated",
              "match": { "project": { "$in": { "$lookup": { "schema": "project", "field": "id", "where": { "members": { "$contains": "$userId" } } } } } }
            },
            { "group": "admin" }
          ],
          "create": [
            {
              "group": "authenticated",
              "match": { "project": { "$in": { "$lookup": { "schema": "project", "field": "id", "where": { "members": { "$contains": "$userId" } } } } } }
            },
            { "group": "admin" }
          ],
          "update": [
            {
              "group": "authenticated",
              "match": { "project": { "$in": { "$lookup": { "schema": "project", "field": "id", "where": { "members": { "$contains": "$userId" } } } } } }
            },
            { "group": "admin" }
          ],
          "delete": [
            {
              "group": "authenticated",
              "match": { "project": { "$in": { "$lookup": { "schema": "project", "field": "id", "where": { "members": { "$contains": "$userId" } } } } } }
            },
            { "group": "admin" }
          ]
        },
        "x-openregister-notifications": {
          "taskDueSoon": {
            "trigger": {
              "type": "scheduled",
              "intervalSec": 3600,
              "filter": {
                "dueDate": { "operator": "withinNext", "value": "PT24H" },
                "status": { "operator": "notEquals", "value": "done" }
              }
            },
            "enabled": true,
            "channels": ["nc-notification"],
            "recipients": [
              { "kind": "field", "field": "assignedTo" }
            ],
            "subject": {
              "en": "Task \"{{title}}\" is due soon",
              "nl": "Taak \"{{title}}\" moet binnenkort af"
            }
          }
        },
        "properties": {
          "title": {
            "title": "Task Title",
            "type": "string",
            "description": "Short title of the task"
          },
          "description": {
            "title": "Description",
            "type": "string",
            "description": "Detailed description"
          },
          "status": {
            "title": "Status",
            "type": "string",
            "description": "Current lifecycle status",
            "enum": ["open", "in_progress", "blocked", "done", "cancelled"],
            "default": "open"
          },
          "priority": {
            "title": "Priority",
            "type": "string",
            "description": "Priority level",
            "enum": ["low", "normal", "high", "urgent"],
            "default": "normal"
          },
          "project": {
            "title": "Project",
            "type": "string",
            "description": "UUID of the parent Project",
            "format": "uuid"
          },
          "zaakUuid": {
            "title": "Zaak UUID",
            "type": "string",
            "description": "UUID of a linked Procest zaak",
            "format": "uuid",
            "nullable": true
          },
          "column": {
            "title": "Column",
            "type": "string",
            "description": "UUID of the kanban Column (null = backlog)",
            "format": "uuid",
            "nullable": true
          },
          "columnOrder": {
            "title": "Column Order",
            "type": "integer",
            "description": "Sort order within the column",
            "default": 0
          },
          "assignedTo": {
            "title": "Assigned To",
            "type": "string",
            "description": "Nextcloud user UID of the assignee"
          },
          "dueDate": {
            "title": "Due Date",
            "type": "string",
            "description": "Due date in ISO 8601 format",
            "format": "date"
          },
          "startDate": {
            "title": "Start Date",
            "type": "string",
            "description": "Start date in ISO 8601 format",
            "format": "date"
          },
          "estimatedDuration": {
            "title": "Estimated Duration",
            "type": "integer",
            "description": "Estimated effort in minutes"
          },
          "percentComplete": {
            "title": "Percent Complete",
            "type": "integer",
            "description": "Completion percentage (0–100)",
            "minimum": 0,
            "maximum": 100,
            "default": 0
          },
          "labels": {
            "title": "Labels",
            "type": "array",
            "description": "UUIDs of linked Label objects",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "default": []
          },
          "parent": {
            "title": "Parent Task",
            "type": "string",
            "description": "UUID of the parent Task (sub-task support)",
            "format": "uuid",
            "nullable": true
          },
          "calendarEventUid": {
            "title": "Calendar Event UID",
            "type": "string",
            "description": "UID of the linked NC Tasks / CalDAV VTODO event",
            "nullable": true
          },
          "completedAt": {
            "title": "Completed At",
            "type": "string",
            "description": "ISO 8601 datetime when the task was completed",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "project": {
        "slug": "project",
        "icon": "FolderOutline",
        "version": "0.1.2",
        "title": "Project",
        "description": "A container grouping related tasks and kanban columns. Maps to schema:CreativeWork.",
        "type": "object",
        "required": ["title", "status"],
        "authorization": {
          "read": [
            {
              "group": "authenticated",
              "match": { "members": { "$contains": "$userId" } }
            },
            { "group": "admin" }
          ],
          "create": ["admin"],
          "update": [
            {
              "group": "authenticated",
              "match": { "owner": "$userId" }
            },
            { "group": "admin" }
          ],
          "delete": [
            {
              "group": "authenticated",
              "match": { "owner": "$userId" }
            },
            { "group": "admin" }
          ]
        },
        "properties": {
          "title": {
            "title": "Project Name",
            "type": "string",
            "description": "Project name"
          },
          "description": {
            "title": "Description",
            "type": "string",
            "description": "Purpose and scope of the project"
          },
          "status": {
            "title": "Status",
            "type": "string",
            "description": "Project lifecycle status",
            "enum": ["active", "archived", "completed"],
            "default": "active"
          },
          "color": {
            "title": "Colour",
            "type": "string",
            "description": "Hex colour code for visual identification",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "icon": {
            "title": "Icon",
            "type": "string",
            "description": "Emoji or MDI icon name"
          },
          "owner": {
            "title": "Owner",
            "type": "string",
            "description": "Nextcloud user UID of the project creator. Set automatically on creation; used for delete authorization and creator-based RBAC."
          },
          "members": {
            "title": "Members",
            "type": "array",
            "description": "Nextcloud user UIDs of project members",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "defaultAssignee": {
            "title": "Default Assignee",
            "type": "string",
            "description": "Nextcloud user UID who receives new tasks by default"
          },
          "caseReference": {
            "title": "Case Reference",
            "type": "string",
            "description": "UUID of a linked Procest case",
            "format": "uuid",
            "nullable": true
          },
          "labels": {
            "title": "Labels",
            "type": "array",
            "description": "UUIDs of Label objects available within this project",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "default": []
          }
        }
      },
      "column": {
        "slug": "column",
        "icon": "ViewColumnOutline",
        "version": "0.1.2",
        "title": "Column",
        "description": "A kanban column belonging to a project. Maps to schema:DefinedTerm.",
        "type": "object",
        "required": ["title", "project", "order"],
        "authorization": {
          "read": [
            {
              "group": "authenticated",
              "match": { "project": { "$in": { "$lookup": { "schema": "project", "field": "id", "where": { "members": { "$contains": "$userId" } } } } } }
            },
            { "group": "admin" }
          ],
          "create": [
            {
              "group": "authenticated",
              "match": { "project": { "$in": { "$lookup": { "schema": "project", "field": "id", "where": { "members": { "$contains": "$userId" } } } } } }
            },
            { "group": "admin" }
          ],
          "update": [
            {
              "group": "authenticated",
              "match": { "project": { "$in": { "$lookup": { "schema": "project", "field": "id", "where": { "members": { "$contains": "$userId" } } } } } }
            },
            { "group": "admin" }
          ],
          "delete": [
            {
              "group": "authenticated",
              "match": { "project": { "$in": { "$lookup": { "schema": "project", "field": "id", "where": { "members": { "$contains": "$userId" } } } } } }
            },
            { "group": "admin" }
          ]
        },
        "properties": {
          "title": {
            "title": "Column Heading",
            "type": "string",
            "description": "Column heading (e.g. 'In Progress')"
          },
          "project": {
            "title": "Project",
            "type": "string",
            "description": "UUID of the parent Project",
            "format": "uuid"
          },
          "order": {
            "title": "Display Order",
            "type": "integer",
            "description": "Left-to-right display order (0-based)",
            "default": 0
          },
          "wipLimit": {
            "title": "WIP Limit",
            "type": "integer",
            "description": "Work-in-progress limit (null = unlimited)",
            "nullable": true
          },
          "color": {
            "title": "Header Colour",
            "type": "string",
            "description": "Hex colour code for the column header",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "type": {
            "title": "Column Type",
            "type": "string",
            "description": "Functional type: active columns hold in-flight work; done columns auto-complete tasks",
            "enum": ["active", "done"],
            "default": "active"
          }
        }
      },
      "timeEntry": {
        "slug": "timeEntry",
        "icon": "TimerOutline",
        "version": "0.1.2",
        "title": "Time Entry",
        "description": "Time logged by a user against a task. Maps to schema:QuantitativeValue.",
        "type": "object",
        "required": ["task", "user", "duration", "date"],
        "authorization": {
          "read": [
            {
              "group": "authenticated",
              "match": { "user": "$userId" }
            },
            {
              "group": "authenticated",
              "match": { "task": { "$in": { "$lookup": { "schema": "task", "field": "id", "where": { "project": { "$in": { "$lookup": { "schema": "project", "field": "id", "where": { "members": { "$contains": "$userId" } } } } } } } } } }
            },
            { "group": "admin" }
          ],
          "create": [
            {
              "group": "authenticated",
              "match": { "user": "$userId" }
            },
            { "group": "admin" }
          ],
          "update": [
            {
              "group": "authenticated",
              "match": { "user": "$userId" }
            },
            { "group": "admin" }
          ],
          "delete": [
            {
              "group": "authenticated",
              "match": { "user": "$userId" }
            },
            { "group": "admin" }
          ]
        },
        "properties": {
          "task": {
            "title": "Task",
            "type": "string",
            "description": "UUID of the related Task",
            "format": "uuid"
          },
          "user": {
            "title": "User",
            "type": "string",
            "description": "Nextcloud user UID of the person who logged the time"
          },
          "duration": {
            "title": "Duration",
            "type": "integer",
            "description": "Time logged in minutes"
          },
          "date": {
            "title": "Work Date",
            "type": "string",
            "description": "Date the work was performed (ISO 8601)",
            "format": "date"
          },
          "description": {
            "title": "Note",
            "type": "string",
            "description": "Optional note about the work performed"
          }
        }
      },
      "label": {
        "slug": "label",
        "icon": "TagOutline",
        "version": "0.1.0",
        "title": "Label",
        "description": "A colour-coded tag applicable to tasks and projects. Maps to schema:DefinedTerm.",
        "type": "object",
        "required": ["title", "color"],
        "authorization": {
          "read": ["authenticated"],
          "create": ["admin"],
          "update": ["admin"],
          "delete": ["admin"]
        },
        "properties": {
          "title": {
            "title": "Label Name",
            "type": "string",
            "description": "Label display name"
          },
          "color": {
            "title": "Colour",
            "type": "string",
            "description": "Hex colour for the label chip",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "default": "#4376FC"
          },
          "description": {
            "title": "Usage Guidance",
            "type": "string",
            "description": "Optional explanation of when to use this label"
          }
        }
      },
      "dependency": {
        "slug": "dependency",
        "icon": "VectorPolyline",
        "version": "0.1.0",
        "title": "Dependency",
        "description": "A directed dependency edge between two tasks of the same project (blocker → blocked). One row per directed edge. Maps to schema:Action.",
        "type": "object",
        "required": ["blocker", "blocked"],
        "authorization": {
          "read": [
            { "group": "authenticated" },
            { "group": "admin" }
          ],
          "create": ["admin"],
          "update": ["admin"],
          "delete": ["admin"]
        },
        "properties": {
          "blocker": {
            "title": "Blocker Task",
            "type": "string",
            "description": "UUID of the task that blocks (must complete before the blocked task can proceed)",
            "format": "uuid"
          },
          "blocked": {
            "title": "Blocked Task",
            "type": "string",
            "description": "UUID of the task that is blocked (waits on the blocker)",
            "format": "uuid"
          }
        }
      }

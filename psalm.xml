                  OpenRegister AppHost generics (ADR-040). Application::registerAppHost()
                  names them as plain FQCN strings and only instantiates them inside a
                  factory closure, so Planix stays loadable with OpenRegister absent.
                -->
                <referencedClass name="OCA\OpenRegister\AppHost\Controller\GenericDashboardController"/>
                <referencedClass name="OCA\OpenRegister\AppHost\Controller\GenericPreferencesController"/>
                <referencedClass name="OCA\OpenRegister\AppHost\Controller\GenericHealthController"/>

                <referencedClass name="OCA\OpenRegister\AppHost\Listener\GenericDeepLinkRegistrationListener"/>
                <!--
                  Planix-namespaced AppHost aliases (ADR-040). These deliberately have NO
                  source file: Nextcloud derives `OCA\Planix\Controller\FooController` from
                  a route named `foo#bar`, and `registerAppHost()` binds each such name in
                  the DI container to an OpenRegister generic. The `::class` constants are
                  service identifiers, never autoloaded — the class genuinely does not
                  exist, and must not, or the alias would shadow the generic.
                -->
                <referencedClass name="OCA\Planix\Controller\DashboardController"/>
                <referencedClass name="OCA\Planix\Controller\PreferencesController"/>
                <referencedClass name="OCA\Planix\Controller\HealthController"/>

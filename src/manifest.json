{
  "$schema": "https://raw.githubusercontent.com/ConductionNL/nextcloud-vue/main/src/schemas/app-manifest-v2.schema.json",
    "setup": {
      "version": 1,
      "completionConfigKey": "setup_completed_version",
      "steps": [
        {
          "id": "welcome",
          "type": "info",
          "title": "Welcome",
          "body": "A short setup to get this app ready. Nothing here is required; you can close it and come back later."
        },
        {
          "id": "demo-data",
          "type": "run-action",
          "action": "install-demo-data",
          "title": "Demo data (optional)",
          "required": false,
          "body": "Load a small example dataset so the lists, detail pages and dashboards show a working product straight away. The data is obviously sample data, it is safe to run more than once, and it can be removed afterwards. Skip this on a production install."
        },
        {
          "id": "done",
          "type": "summary",
          "title": "All set"
        }
      ]
    },
  "version": "0.1.0",
  "dependencies": ["openregister"],
  "menu": [
    { "id": "Dashboard", "label": "Dashboard", "icon": "Home", "route": "Dashboard", "order": 10 },
    { "id": "Boards", "label": "Boards", "icon": "ViewDashboardOutline", "route": "Boards", "order": 20 },
    { "id": "Projects", "label": "Projects", "icon": "FolderOutline", "route": "Projects", "order": 30 },
    { "id": "Portfolio", "label": "Portfolio", "icon": "ChartBar", "route": "Portfolio", "order": 40 },
    { "id": "Timesheet", "label": "Timesheet", "icon": "ClockOutline", "route": "Timesheet", "order": 50 },
    { "id": "Documentation", "label": "Documentation", "icon": "BookOpenVariantOutline", "href": "https://planix.conduction.nl", "section": "footer", "order": 90 }
  ],
  "pages": [
    {
      "id": "Dashboard",
      "route": "/",
      "type": "dashboard",
      "title": "Dashboard",
      "config": {
        "widgets": [
          {
            "id": "kpi-active-projects",
            "type": "stat",
            "title": "Active projects",
            "content": {
              "label": "Active projects",
              "icon": "FolderOutline",
              "route": { "name": "Projects" },
              "format": { "style": "decimal", "decimals": 0 },
              "source": {
                "register": "planninq",
                "schema": "project",
                "metric": "count",
                "filter": { "status": "active" }
              }
            }
          },
          {
            "id": "kpi-member-projects",
            "type": "stat",
            "title": "Projects I am in",
            "content": {
              "label": "Projects I am in",
              "icon": "AccountGroup",
              "route": { "name": "Projects" },
              "format": { "style": "decimal", "decimals": 0 },
              "source": {
                "register": "planninq",
                "schema": "project",
                "metric": "count"
              }
            }
          },
          {
            "id": "kpi-archived-projects",
            "type": "stat",
            "title": "Archived projects",
            "content": {
              "label": "Archived projects",
              "icon": "History",
              "route": { "name": "Projects" },
              "format": { "style": "decimal", "decimals": 0 },
              "source": {
                "register": "planninq",
                "schema": "project",
                "metric": "count",
                "filter": { "status": "archived" }
              }
            }
          },
          {
            "id": "dashboard-panels",
            "type": "project-panels",
            "title": "My projects",
            "_note": "The two non-KPI panels (My projects, Quick actions), rendered by the `project-panels` widget type, which src/registry.js maps to DashboardPanels. CnWidgetGrid resolves a manifest widget by its TYPE against the app registry before the library catalog, so the key there is the type string, not this id. DashboardPanels is a plain component, NOT a nested CnDashboardPage: hydra gate-15 rejects a dashboard inside a dashboard."
          }
        ],
        "layout": [
          { "id": "1", "widgetId": "kpi-active-projects", "gridX": 0, "gridY": 0, "gridWidth": 4, "gridHeight": 2, "showTitle": false },
          { "id": "2", "widgetId": "kpi-member-projects", "gridX": 4, "gridY": 0, "gridWidth": 4, "gridHeight": 2, "showTitle": false },
          { "id": "3", "widgetId": "kpi-archived-projects", "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 2, "showTitle": false },
          { "id": "4", "widgetId": "dashboard-panels", "gridX": 0, "gridY": 2, "gridWidth": 12, "gridHeight": 5, "showTitle": false, "borderless": true }
        ]
      }
    },
    { "id": "Projects", "route": "/projects", "type": "custom", "title": "Projects", "component": "ProjectList", "config": {} },
    { "id": "ProjectBoard", "route": "/projects/:id", "type": "custom", "title": "Project board", "component": "ProjectBoard", "config": {} },
    { "id": "ProjectBacklog", "route": "/projects/:id/backlog", "type": "custom", "title": "Backlog", "component": "ProjectBacklog", "config": {} },
    { "id": "ProjectTimeline", "route": "/projects/:id/timeline", "type": "custom", "title": "Timeline", "component": "ProjectTimeline", "config": {} },
    { "id": "TaskDetail", "route": "/projects/:id/tasks/:taskId", "type": "custom", "title": "Task", "component": "TaskDetail", "config": {} },
    { "id": "Timesheet", "route": "/timesheet", "type": "custom", "title": "Timesheet", "component": "Timesheet", "config": {} },
    { "id": "Boards", "route": "/boards", "type": "custom", "title": "Boards", "component": "Boards", "config": {} },
    { "id": "Portfolio", "route": "/portfolio", "type": "custom", "title": "Portfolio", "component": "Portfolio", "config": {} }
  ],
  "observability": {
    "_note": "AppHost manifest (ADR-040). The observability block reproduces the output of the now-deleted hand-written HealthController + MetricsController; /api/health and /api/metrics are aliased to AppHost\\Controller\\GenericHealth#index / GenericMetrics#index in appinfo/routes.php. The deepLinks block replaces the hand-written DeepLinkRegistrationListener, read at event time by the generic listener. Parity: the database health check and the implicit {appId}_info/{appId}_up metrics match the pre-adoption contract — those two are derived from the runtime app id, so they read planninq_info/planninq_up after the planix -> planninq rename; the task/project object counts are a documented intentional improvement (object-count observability the bespoke MetricsController never emitted). The `register` and `registerSlug` values below are the OpenRegister register slug, not the app id — they moved from `planix` to `planninq` alongside the MigrateRegisterSlug repair step that renames the register ROW. They only work because that step runs: the slug is what a lookup resolves a register by, so a renamed slug here without the row rename would resolve nothing (and, on the import path, fork a second empty register). This was an observability-only manifest until 2026-08-31, when planninq adopted the manifest shell: it now also carries `dependencies`, `menu` and `pages`, CnAppRoot renders the nav and the OpenRegister dependency gate, and vue-router routes are built from `pages[]` in main.js. The former top-level appId/name keys were removed 2026-07-06 (not part of the v2 contract; the app id comes from the runtime).",
    "health": {
      "statusCodePolicy": "adr006",
      "checks": [
        { "id": "database", "type": "database", "severity": "critical" }
      ]
    },
    "metrics": [
      {
        "name": "tasks_total",
        "type": "gauge",
        "help": "Total tasks by status",
        "source": {
          "kind": "objectCount",
          "register": "planninq",
          "schema": "task",
          "groupBy": ["status"]
        }
      },
      {
        "name": "projects_total",
        "type": "gauge",
        "help": "Total projects by status",
        "source": {
          "kind": "objectCount",
          "register": "planninq",
          "schema": "project",
          "groupBy": ["status"]
        }
      }
    ]
  },
  "deepLinks": [
    {
      "registerSlug": "planninq",
      "schemaSlug": "task",
      "urlTemplate": "/apps/planninq/projects/{project}?task={uuid}",
      "displayName": "Task"
    },
    {
      "registerSlug": "planninq",
      "schemaSlug": "project",
      "urlTemplate": "/apps/planninq/projects/{uuid}",
      "displayName": "Project"
    },
    {
      "registerSlug": "planninq",
      "schemaSlug": "column",
      "urlTemplate": "/apps/planninq/projects/{project}",
      "displayName": "Column"
    },
    {
      "registerSlug": "planninq",
      "schemaSlug": "label",
      "urlTemplate": "/apps/planninq/projects",
      "displayName": "Label"
    },
    {
      "registerSlug": "planninq",
      "schemaSlug": "timeEntry",
      "urlTemplate": "/apps/planninq/projects/{project}?task={task}",
      "displayName": "Time entry"
    }
  ]
}

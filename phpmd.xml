<?xml version="1.0"?>
<ruleset name="planninq"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 http://pmd.sourceforge.net/ruleset_xml_schema.xsd">
    <description>planninq — Conduction PHPMD ruleset (single source: conduction/hydra-gates).</description>

    <!--
        The shared ruleset is the source of truth. A deviation belongs here as an
        <exclude> plus a re-declaration with this app's properties, so it reads as
        a deviation instead of hiding inside a full private copy of the rules —
        which is how the fleet ended up with several drifting variants of one file.
    -->
    <rule ref="vendor/conduction/hydra-gates/quality-config/phpmd.xml">
        <exclude name="ExcessiveClassComplexity"/>
        <exclude name="CouplingBetweenObjects"/>
    </rule>

    <!--
        ProjectController and SettingsController carry the app's policy checks and
        their OpenRegister error classification, which puts them above the shared
        threshold. Raised rather than silenced, so the number still has to come
        down as those methods are decomposed.
    -->
    <rule ref="rulesets/codesize.xml/ExcessiveClassComplexity">
        <properties>
            <property name="maximum" value="75"/>
        </properties>
    </rule>

    <!--
        AppInfo\Application is the composition root: its dependency count IS its
        job, and the shared threshold of 13 is aimed at domain classes that
        should be decomposed instead. Adding the ADR-040 autoload prelude took it
        from 12 to 13, which the shared rule reports. Raised by one, with the
        same posture as the override above: raised rather than silenced, so the
        number still has to come down if this class grows past a bootstrap.
    -->
    <rule ref="rulesets/design.xml/CouplingBetweenObjects">
        <properties>
            <property name="maximum" value="14"/>
        </properties>
    </rule>
</ruleset>

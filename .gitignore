# Playwright e2e artefacts (ADR-030 / journeydoc) are ignored by
# tests/e2e/.gitignore (playwright-report/, test-results/, .auth/), NOT here.
#
# ⚠️ Do NOT copy the opencatalogi reference and add `/playwright-report/` and
# `/test-results/` at the app root. That repo moved its CI config's outputDir to
# the app root because the shared workflow uploads
# `server/apps/<app>/{playwright-report,test-results}/`. In planninq the app-root
# `test-results/` directory is TRACKED — it holds the persona test reports the
# rules just below deliberately keep in git — so pointing Playwright at it would
# drop trace folders into a documentation directory and `/test-results/` here
# would then hide every new report. The shared workflow's upload steps also list
# `.../tests/e2e/playwright-report/` and `.../tests/e2e/test-results/`, so
# tests/e2e/playwright.config.ts keeps the scaffolded locations and CI still
# gets a downloadable report and traces.

# Test screenshots — images generated by browser test commands (test-app, run-test-scenario)
# Only images are ignored; markdown reports and scenario files are kept in git.
test-results/**/*.png
test-results/**/*.jpg
test-results/**/*.jpeg
test-results/**/*.gif
test-results/**/*.webp
openspec/test-site-results/**/*.png
openspec/test-site-results/**/*.jpg
openspec/test-site-results/**/*.jpeg
openspec/test-site-results/**/*.gif
openspec/test-site-results/**/*.webp
composer.phar

# Playwright visual baselines are renderer-specific: a PNG generated on a
# developer's machine fails CI on font/rasterisation differences alone. Capture
# them locally with PLANIX_VISUAL_BASELINE=1 --update-snapshots; do not commit.
tests/e2e/**/*-snapshots/
